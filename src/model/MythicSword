extends Area2D
class_name MythicSword

const DAMAGE: int = 75
const MAX_HOLD_TIME: float = 20.0
const COOLDOWN_TIME: float = 10.0

var current_hold_time: float = 0.0
var current_cooldown: float = 0.0

var is_equipped: bool = false
var is_on_cooldown: bool = false

var player: Node2D = null
var ui_manager: Node = null

func _ready():
    # Buscamos el UI Manager en la escena usando Grupos
    var uis = get_tree().get_nodes_in_group("ui_manager")
    if uis.size() > 0:
        ui_manager = uis[0]
        
    # Conectamos la señal para detectar si el jugador se para encima
    body_entered.connect(_on_body_entered)

func _process(delta: float):
    # 1. Lógica del Cooldown (cuando está en el suelo)
    if is_on_cooldown and not is_equipped:
        current_cooldown -= delta
        
        if ui_manager and ui_manager.has_method("update_sword_cooldown"):
            ui_manager.update_sword_cooldown(current_cooldown)
            
        if current_cooldown <= 0:
            is_on_cooldown = false
            current_cooldown = 0
            if ui_manager and ui_manager.has_method("hide_sword_ui"):
                ui_manager.hide_sword_ui()
            print("Espada Mítica lista para recoger de nuevo.")

    # 2. Lógica de la Maldición (cuando está equipada)
    if is_equipped and player != null:
        current_hold_time += delta
        var time_left = MAX_HOLD_TIME - current_hold_time
        
        # Actualiza el contador visible en la pantalla
        if ui_manager and ui_manager.has_method("update_sword_timer"):
            ui_manager.update_sword_timer(time_left)
            
        # Si llega a 20 segundos, el jugador explota
        if current_hold_time >= MAX_HOLD_TIME:
            detonate_explosion()

func detonate_explosion():
    print("¡BOOM! El jugador explota por retener la espada más de 20s.")
    
    # Aquí puedes instanciar un efecto visual de explosión
    # var explosion = explosion_scene.instantiate()
    # get_tree().current_scene.add_child(explosion)
    # explosion.global_position = player.global_position
    
    if player.has_method("take_damage"):
        player.take_damage(9999) # Daño crítico / Instakill
        
    drop()

func attack(target: Node2D):
    if is_equipped and target.has_method("take_damage"):
        target.take_damage(DAMAGE)

func equip(p: Node2D) -> bool:
    if is_on_cooldown:
        print("La espada está en cooldown.")
        return false
        
    player = p
    is_equipped = true
    current_hold_time = 0.0
    
    if ui_manager and ui_manager.has_method("show_sword_timer"):
        ui_manager.show_sword_timer()
        
    print("Mithic Sword equipada. 20 segundos antes de explotar.")
    
    # En Godot, al equipar un arma suele moverse como hijo del jugador
    get_parent().remove_child(self)
    player.add_child(self)
    position = Vector2(20, 0) # Posición relativa en la mano del jugador
    
    return true

func drop():
    if is_equipped:
        is_equipped = false
        
        # Regresar la espada a la escena principal al soltarla
        var drop_position = global_position
        player.remove_child(self)
        get_tree().current_scene.add_child(self)
        global_position = drop_position
        
        player = null
        is_on_cooldown = true
        current_cooldown = COOLDOWN_TIME
        print("Mithic Sword soltada. Entrando en cooldown de 10s.")

func _on_body_entered(body: Node2D):
    if body.is_in_group("player") and not is_equipped and not is_on_cooldown:
        print("Jugador en rango. Presiona el botón de acción para equipar la Espada Mítica.")