extends Node2D
class_name Phase3Manager

var skeletons_alive: int = 6
var is_phase_completed: bool = false

# Exportamos las variables para arrastrar las escenas en el Inspector de Godot
@export var skeleton_scene: PackedScene 
@export var mythic_sword_scene: PackedScene

func _ready():
    add_to_group("phase3_manager") # Se añade al grupo para que los esqueletos lo encuentren
    print("--- INICIANDO FASE 3 ---")
    print("Generando matriz de combate de 100x100...")
    spawn_skeletons()

func spawn_skeletons():
    print("Aparecen 6 Esqueletos en la arena.")
    for i in range(skeletons_alive):
        if skeleton_scene:
            var skel = skeleton_scene.instantiate()
            # Posición aleatoria dentro del área 100x100 (ajustado a escala de píxeles)
            skel.global_position = Vector2(randf_range(100, 900), randf_range(100, 900))
            add_child(skel)

# Llamado por el esqueleto justo antes de ejecutar queue_free()
func report_skeleton_death():
    skeletons_alive -= 1
    print("Esqueletos restantes: ", skeletons_alive)
    
    if skeletons_alive <= 0 and not is_phase_completed:
        complete_phase()

func complete_phase():
    is_phase_completed = true
    print("¡Oleada derrotada! La arena está despejada.")
    spawn_mythic_sword()
    open_corridor()

func spawn_mythic_sword():
    print("¡Ha aparecido la Mythic Sword en el centro!")
    if mythic_sword_scene:
        var sword = mythic_sword_scene.instantiate()
        sword.global_position = Vector2(500, 500) # Centro lógico
        get_tree().current_scene.add_child(sword)

func open_corridor():
    print("Se ha abierto la puerta hacia el pasillo (50x20) de curación.")
